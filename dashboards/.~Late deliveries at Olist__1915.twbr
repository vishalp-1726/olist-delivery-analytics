          <datasource-dependencies datasource='federated.zsx3d4fqodp75xgwlls9manwylgo'>
            <column caption='Is problem state' datatype='boolean' name='[Is problem state]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[customer_state] = &quot;BA&quot; OR [customer_state] = &quot;CE&quot; OR [customer_state] = &quot;PE&quot; OR [customer_state] = &quot;RJ&quot;' />
            </column>
            <column caption='Problem share of late' datatype='real' default-format='p0.0%' name='[Problem share of late]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Is problem state] THEN [late_orders] END) / SUM([late_orders])' />
            </column>
            <column caption='Problem share of orders' datatype='real' default-format='p0.0%' name='[Problem share of orders]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Is problem state] THEN [orders] END) / SUM([orders])' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Late Orders' datatype='integer' default-format='n#,##0' name='[late_orders]' role='measure' type='quantitative' />
