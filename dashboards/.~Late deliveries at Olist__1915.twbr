          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Purchase month from' datatype='date' default-format='*mmm-yyyy' name='[Purchase month from]' param-domain-type='list' role='measure' type='quantitative' value='#2017-01-01#'>
              <calculation class='tableau' formula='#2017-01-01#' />
            </column>
            <column caption='Purchase month to' datatype='date' default-format='*mmm-yyyy' name='[Purchase month to]' param-domain-type='list' role='measure' type='quantitative' value='#2018-08-01#'>
              <calculation class='tableau' formula='#2018-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.i6w9tz9iw8djjabm0d8sn5wuvf1n'>
            <column caption='In month range' datatype='boolean' name='[In month range]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[purchase_month] &gt;= [Parameters].[Purchase month from] AND [purchase_month] &lt;= [Parameters].[Purchase month to]' />
            </column>
            <column caption='TT stars' datatype='real' default-format='n#,##0.00' name='[TT stars]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_review])' />
            </column>
            <column caption='Avg Review' datatype='real' default-format='n#,##0.00' name='[avg_review]' role='measure' type='quantitative' />
            <column-instance column='[In month range]' derivation='None' name='[none:In month range:nk]' pivot='key' type='nominal' />
