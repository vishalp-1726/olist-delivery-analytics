              <text column='[federated.lclc3i73od3db641oj9r672shcql].[usr:Carrier days on time:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontcolor='#10303a' fontsize='9'>Days with the carrier, late orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#0e7490' fontsize='20'><![CDATA[<[federated.lclc3i73od3db641oj9r672shcql].[usr:Carrier days late:qk]>]]></run>
                <run bold='true' fontcolor='#0e7490' fontsize='20'> days</run>
