      <column caption='All states rate' datatype='real' default-format='p0.00%' name='[All states rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : SUM([late_orders]) / SUM([orders])}' />
      </column>
      <column caption='Big enough' datatype='boolean' name='[Big enough]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[orders] &gt;= [Parameters].[Minimum orders]' />
      </column>
      <column caption='CI width' datatype='real' default-format='p0.00%' name='[CI width]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ci_high]) - SUM([ci_low])' />
      </column>
      <column caption='Is problem state' datatype='boolean' name='[Is problem state]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[customer_state] = &quot;BA&quot; OR [customer_state] = &quot;CE&quot; OR [customer_state] = &quot;PE&quot; OR [customer_state] = &quot;RJ&quot;' />
      </column>
      <column caption='Label above' datatype='real' default-format='p0.00%' name='[Label above]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Versus all states] = &quot;Above&quot; THEN [late_rate] END' />
      </column>
      <column caption='Label other' datatype='real' default-format='p0.00%' name='[Label other]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Versus all states] &lt;&gt; &quot;Above&quot; THEN [late_rate] END' />
      </column>
      <column caption='Problem share of late' datatype='real' default-format='p0.0%' name='[Problem share of late]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is problem state] THEN [late_orders] END) / SUM([late_orders])' />
      </column>
      <column caption='Problem share of orders' datatype='real' default-format='p0.0%' name='[Problem share of orders]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is problem state] THEN [orders] END) / SUM([orders])' />
      </column>
      <column caption='TT ci low' datatype='real' default-format='p0.00%' name='[TT ci low]' role='measure' type='quantitative'>
