                  <column datatype='real' name='rate' ordinal='3' />
                  <column datatype='real' name='diff_ci_low' ordinal='4' />
                  <column datatype='real' name='diff_ci_high' ordinal='5' />
                  <column datatype='real' name='p_value' ordinal='6' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='T1 Bad reviews'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>1-2 star reviews by days late: </run>
            <run bold='true' fontcolor='#1f5fbf' fontname='Tableau Semibold' fontsize='10'>on time</run>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> vs </run>
            <run bold='true' fontcolor='#c2410c' fontname='Tableau Semibold' fontsize='10'>late</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>95% CI within ±2.5 points for every band (in the tooltip)</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='late_bands' name='federated.rqrls0ezrbajxba7cpwi3yh2z60c' />
          </datasources>
          <datasource-dependencies datasource='federated.rqrls0ezrbajxba7cpwi3yh2z60c'>
            <column caption='Is late band' datatype='boolean' name='[Is late band]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[late_band] &lt;&gt; &quot;0 on time or early&quot;' />
            </column>
            <column caption='TT bad share' datatype='real' default-format='p0.00%' name='[TT bad share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bad_review_share])' />
            </column>
            <column caption='Avg Review' datatype='real' default-format='n#,##0.00' name='[avg_review]' role='measure' type='quantitative' />
            <column caption='Bad Review Share' datatype='real' default-format='p0.00%' name='[bad_review_share]' role='measure' type='quantitative' />
            <column caption='Bad Reviews' datatype='integer' default-format='n#,##0' name='[bad_reviews]' role='measure' type='quantitative' />
            <column caption='Ci High' datatype='real' default-format='p0.00%' name='[ci_high]' role='measure' type='quantitative' />
            <column caption='Ci Low' datatype='real' default-format='p0.00%' name='[ci_low]' role='measure' type='quantitative' />
            <column caption='Late Band' datatype='string' name='[late_band]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;0 on time or early&quot;' value='on time or early' />
                <alias key='&quot;1 1-3 days late&quot;' value='1-3 days late' />
                <alias key='&quot;2 4-7 days late&quot;' value='4-7 days late' />
                <alias key='&quot;3 8-14 days late&quot;' value='8-14 days late' />
                <alias key='&quot;4 15+ days late&quot;' value='15+ days late' />
              </aliases>
            </column>
            <column-instance column='[Is late band]' derivation='None' name='[none:Is late band:nk]' pivot='key' type='nominal' />
            <column-instance column='[late_band]' derivation='None' name='[none:late_band:nk]' pivot='key' type='nominal' />
            <column caption='Orders' datatype='integer' default-format='n#,##0' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[avg_review]' derivation='Sum' name='[sum:avg_review:qk]' pivot='key' type='quantitative' />
            <column-instance column='[bad_review_share]' derivation='Sum' name='[sum:bad_review_share:qk]' pivot='key' type='quantitative' />
            <column-instance column='[bad_reviews]' derivation='Sum' name='[sum:bad_reviews:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ci_high]' derivation='Sum' name='[sum:ci_high:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ci_low]' derivation='Sum' name='[sum:ci_low:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[TT bad share]' derivation='User' name='[usr:TT bad share:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.rqrls0ezrbajxba7cpwi3yh2z60c].[none:late_band:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;0 on time or early&quot;</bucket>
              <bucket>&quot;1 1-3 days late&quot;</bucket>
              <bucket>&quot;2 4-7 days late&quot;</bucket>
              <bucket>&quot;3 8-14 days late&quot;</bucket>
              <bucket>&quot;4 15+ days late&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.rqrls0ezrbajxba7cpwi3yh2z60c].[sum:bad_review_share:qk]' scope='rows' value='' />
