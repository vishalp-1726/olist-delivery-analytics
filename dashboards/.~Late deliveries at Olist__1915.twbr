      <aliases enabled='yes' />
      <column caption='In month range' datatype='boolean' name='[In month range]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[purchase_month] &gt;= [Parameters].[Purchase month from] AND [purchase_month] &lt;= [Parameters].[Purchase month to]' />
      </column>
      <column caption='Late rate all' datatype='real' default-format='p0.00%' name='[Late rate all]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_orders]) / SUM([delivered_orders])' />
      </column>
      <column caption='Spike label' datatype='real' default-format='p0.00%' name='[Spike label]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [late_rate] &gt; 0.10 THEN [late_rate] END' />
      </column>
      <column caption='Spike share' datatype='real' default-format='p0%' name='[Spike share]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [late_rate] &gt; 0.10 THEN [late_orders] END) / SUM([late_orders])' />
      </column>
      <column caption='TT delivery days' datatype='real' default-format='n#,##0.0' name='[TT delivery days]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_delivery_days])' />
      </column>
      <column caption='TT late rate' datatype='real' default-format='p0.00%' name='[TT late rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_rate])' />
      </column>
      <column caption='TT promised days' datatype='real' default-format='n#,##0.0' name='[TT promised days]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_promised_days])' />
      </column>
      <column caption='TT stars' datatype='real' default-format='n#,##0.00' name='[TT stars]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_review])' />
      </column>
      <column caption='Worst month late orders' datatype='integer' default-format='n#,##0' name='[Worst month late orders]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [purchase_month] = [Worst month] THEN [late_orders] END)' />
      </column>
      <column caption='Worst month' datatype='date' default-format='*mmm-yyyy' name='[Worst month]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [late_rate] = {FIXED : MAX([late_rate])} THEN [purchase_month] END)}' />
      </column>
