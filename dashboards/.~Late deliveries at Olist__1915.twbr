    <worksheet name='T2 KPI carrier days'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>T2 KPI carrier days</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='time_split' name='federated.lclc3i73od3db641oj9r672shcql' />
          </datasources>
          <datasource-dependencies datasource='federated.lclc3i73od3db641oj9r672shcql'>
            <column caption='Carrier days late' datatype='real' default-format='n#,##0.0' name='[Carrier days late]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery] = &quot;Late&quot; THEN [avg_days_with_carrier] END)' />
            </column>
            <column caption='Carrier days on time' datatype='real' default-format='n#,##0.0' name='[Carrier days on time]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery] = &quot;On time&quot; THEN [avg_days_with_carrier] END)' />
            </column>
            <column caption='Avg Days With Carrier' datatype='real' default-format='n#,##0.0' name='[avg_days_with_carrier]' role='measure' type='quantitative' />
            <column caption='Delivery' datatype='string' name='[delivery]' role='dimension' type='nominal' />
            <column-instance column='[Carrier days late]' derivation='User' name='[usr:Carrier days late:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Carrier days on time]' derivation='User' name='[usr:Carrier days on time:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
