              <calculation class='tableau' formula='SUM(IF [handover] = &quot;Seller handed over late&quot; THEN [late_rate] END)' />
            </column>
            <column caption='Late if seller on time' datatype='real' default-format='p0.00%' name='[Late if seller on time]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [handover] = &quot;Seller handed over on time&quot; THEN [late_rate] END)' />
            </column>
            <column caption='Handover' datatype='string' name='[handover]' role='dimension' type='nominal' />
            <column caption='Late Rate' datatype='real' default-format='p0.00%' name='[late_rate]' role='measure' type='quantitative' />
