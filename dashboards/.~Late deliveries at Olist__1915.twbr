            <run bold='true' fontcolor='#1f5fbf' fontname='Tableau Semibold' fontsize='10'>Average review score</run>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> by purchase month: lowest in the spike months</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
