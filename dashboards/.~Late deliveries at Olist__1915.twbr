    <worksheet name='T2 States'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'>Late rate by customer state, 95% CI: </run>
            <run bold='true' fontcolor='#c2410c' fontname='Tableau Semibold' fontsize='10'>above</run>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> / </run>
            <run bold='true' fontcolor='#1f5fbf' fontname='Tableau Semibold' fontsize='10'>below</run>
            <run bold='true' fontcolor='#515151' fontname='Tableau Semibold' fontsize='10'> all states</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='states' name='federated.zsx3d4fqodp75xgwlls9manwylgo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Minimum orders' datatype='integer' default-format='n#,##0' name='[Minimum orders]' param-domain-type='list' role='measure' type='quantitative' value='1000'>
              <calculation class='tableau' formula='1000' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.zsx3d4fqodp75xgwlls9manwylgo'>
            <column caption='All states rate' datatype='real' default-format='p0.00%' name='[All states rate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : SUM([late_orders]) / SUM([orders])}' />
            </column>
            <column caption='Big enough' datatype='boolean' name='[Big enough]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[orders] &gt;= [Parameters].[Minimum orders]' />
            </column>
            <column caption='CI width' datatype='real' default-format='p0.00%' name='[CI width]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ci_high]) - SUM([ci_low])' />
            </column>
            <column caption='Label above' datatype='real' default-format='p0.00%' name='[Label above]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Versus all states] = &quot;Above&quot; THEN [late_rate] END' />
            </column>
            <column caption='Label other' datatype='real' default-format='p0.00%' name='[Label other]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Versus all states] &lt;&gt; &quot;Above&quot; THEN [late_rate] END' />
            </column>
            <column caption='TT ci low' datatype='real' default-format='p0.00%' name='[TT ci low]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ci_low])' />
            </column>
            <column caption='Versus all states' datatype='string' name='[Versus all states]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ci_low] &gt; [All states rate] THEN &quot;Above&quot;&#10;ELSEIF [ci_high] &lt; [All states rate] THEN &quot;Below&quot;&#10;ELSE &quot;Not clearly different&quot; END' />
            </column>
            <column-instance column='[All states rate]' derivation='Avg' name='[avg:All states rate:qk]' pivot='key' type='quantitative' />
            <column caption='Ci High' datatype='real' default-format='p0.00%' name='[ci_high]' role='measure' type='quantitative' />
            <column caption='Ci Low' datatype='real' default-format='p0.00%' name='[ci_low]' role='measure' type='quantitative' />
